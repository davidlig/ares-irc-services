<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\ChanServ\Domain\Entity\ChannelRegistrationAudit" table="channel_registration_audit">
        <id name="id" type="integer" column="id">
            <generator strategy="IDENTITY"/>
        </id>
        <field name="channelName" type="string" length="64" column="channel_name"/>
        <field name="requesterAccountId" type="integer" column="requester_account_id"/>
        <field name="operatorAccountId" type="integer" column="operator_account_id"/>
        <field name="operatorNickname" type="string" length="64" column="operator_nickname"/>
        <field name="accepted" type="boolean" column="accepted"/>
        <field name="rejectionReason" type="text" nullable="true" column="rejection_reason"/>
        <field name="restrictedUntil" type="datetime_immutable" nullable="true" column="restricted_until"/>
        <field name="occurredAt" type="datetime_immutable" column="occurred_at"/>
    </entity>
</doctrine-mapping>
