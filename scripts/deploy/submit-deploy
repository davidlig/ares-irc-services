#!/usr/bin/env python3
"""Submit a bounded artifact request to the protected host deployment socket."""
import json
import re
import socket
import sys

MARKER = b'__ARES_DEPLOY_STATUS__:'
MAX_RESPONSE = 1024 * 1024


def request(args):
    if len(args) != 3 or not re.fullmatch(r'[0-9a-f]{64}', args[1]) or not re.fullmatch(r'[0-9a-f]{40}', args[2]):
        raise ValueError('invalid deployment arguments')
    if not args[0].startswith('/runner-state/_work/'):
        raise ValueError('artifact is outside runner work directory')
    encoded = json.dumps(args, separators=(',', ':')).encode() + b'\n'
    if len(encoded) > 4096:
        raise ValueError('deployment request too large')
    return encoded


def status(data):
    # Do not print server output: build tools can accidentally expose configuration.
    match = re.search(rb'(?:^|\n)__ARES_DEPLOY_STATUS__:([0-9]{1,3})\n?\Z', data)
    if match is None or int(match[1]) > 255:
        raise ValueError('deployment service returned invalid status')
    return int(match[1])


def main():
    try:
        payload = request(sys.argv[1:])
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
            connection.settimeout(1800)
            connection.connect('/runner-state/deploy.sock')
            connection.sendall(payload)
            connection.shutdown(socket.SHUT_WR)
            response = bytearray()
            while True:
                chunk = connection.recv(65536)
                if not chunk:
                    break
                response.extend(chunk)
                if len(response) > MAX_RESPONSE:
                    raise ValueError('deployment response too large')
        result = status(bytes(response))
        print('Deployment succeeded.' if result == 0 else 'Deployment failed; inspect protected host diagnostics.')
        return result
    except (OSError, ValueError):
        print('Deployment transport rejected or unavailable.', file=sys.stderr)
        return 64


if __name__ == '__main__':
    sys.exit(main())
