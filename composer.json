{
    "name": "davidlig/ares-irc-services",
    "description": "Modular IRC services daemon. PHP 8.6, Symfony 7.4, Clean Architecture.",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "keywords": ["irc", "services", "php", "development"],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.6",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-mbstring": "*",
        "ext-pdo_mysql": "*",
        "ext-pdo_sqlite": "*",
        "amphp/amp": "3.1.*",
        "amphp/dns": "2.4.*",
        "amphp/socket": "2.4.*",
        "doctrine/doctrine-bundle": "3.2.*",
        "doctrine/doctrine-migrations-bundle": "4.0.*",
        "doctrine/orm": "3.6.*",
        "revolt/event-loop": "1.1.*",
        "symfony/console": "7.4.*",
        "symfony/doctrine-messenger": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/flex": "2.10.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/lock": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/messenger": "7.4.*",
        "symfony/monolog-bundle": "4.0.*",
        "symfony/runtime": "7.4.*",
        "symfony/security-core": "7.4.*",
        "symfony/translation": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "platform": {
            "php": "8.6.0"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Migrations\\": "migrations/",
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "architecture": "deptrac analyse --config-file=deptrac.yaml --no-progress --fail-on-uncovered --report-uncovered",
        "cs-check": "dresscode check",
        "cs-fix": "dresscode fix",
        "yaml-fix": "npm run yaml:fix",
        "yaml-check": "npm run yaml:check",
        "phpstan": "phpstan analyse src/ tests/ --level=max --error-format=raw --no-progress"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*",
            "docker": false
        }
    },
    "suggest": {
        "ext-sockets": "Sets TCP_USER_TIMEOUT so a lost uplink with unacknowledged data is detected in about two minutes"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7.2",
        "dresscode/dresscode": "^1.4",
        "nette/neon": "^4.0",
        "phpstan/phpstan": "^2.3.7",
        "phpstan/phpstan-phpunit": "^2.1.4",
        "phpunit/phpunit": "^13.4.8"
    }
}
